{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JimmyJuan/figma_skills/blob/main/rules/linear-user-journey/references/linear-journey-manifest.schema.json",
  "title": "Linear user journey migration manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "journey_id", "actor", "outcome", "occurrences", "transitions"],
  "properties": {
    "version": { "const": "1.0" },
    "journey_id": { "type": "string", "pattern": "^J[0-9]{2}(?:-[A-Z0-9]+)*$" },
    "actor": { "type": "string", "minLength": 1 },
    "outcome": { "type": "string", "minLength": 1 },
    "occurrences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["occurrence_id", "screen_id", "figma_node_id", "scope"],
        "properties": {
          "occurrence_id": { "type": "string", "pattern": "^J[0-9]{2}(?:-[A-Z0-9]+)*-[SBR][0-9]{2}$" },
          "screen_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "figma_node_id": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" },
          "main_component_node_id": { "type": ["string", "null"], "pattern": "^[0-9]+:[0-9]+$" },
          "scope": { "enum": ["main_component", "instance_override", "journey_annotation", "migration"] },
          "mapping_status": { "enum": ["proposed", "approved", "migrated", "disputed"] },
          "semantic_rationale": { "type": "string" }
        }
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["transition_id", "source_occurrence_id", "target_occurrence_id", "kind", "label"],
        "properties": {
          "transition_id": { "type": "string", "pattern": "^T[0-9]{2,}$" },
          "source_occurrence_id": { "type": "string" },
          "target_occurrence_id": { "type": "string" },
          "kind": { "enum": ["user_action", "system_event", "decision", "elapsed_time", "alternate_entry", "cross_role"] },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
